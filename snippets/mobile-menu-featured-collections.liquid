{%- comment -%}
Mobile Menu Featured Collections
Renders the two featured pictures for a mobile menu panel.

Variables:
- featured_block: a mega_menu or mobile_menu_pictures block with featured_collection_1/2 settings
- show: Whether to display this component
{%- endcomment -%}

{%- if show and featured_block -%}
  {%- capture featured_items -%}
    {%- for i in (1..2) -%}
      {%- liquid
        assign collection_key = 'featured_collection_' | append: i
        assign image_key = collection_key | append: '_image'
        assign title_key = collection_key | append: '_title'
        assign link_key = collection_key | append: '_link'

        assign featured_collection = blank
        if featured_block.settings[collection_key] != blank
          assign featured_collection = collections[featured_block.settings[collection_key]]
        endif

        assign featured_url = featured_block.settings[link_key] | default: featured_collection.url
        assign featured_image = featured_block.settings[image_key] | default: featured_collection.featured_image
        assign featured_title = featured_block.settings[title_key] | default: featured_collection.title
      -%}

      {%- if featured_url != blank -%}
        <div class="o-mobile-menu__featured-collection">
          <a href="{{ featured_url }}" class="o-mobile-menu__featured-collection-link">
            <div class="o-mobile-menu__featured-collection-image">
              {%- if featured_image != blank -%}
                {{ featured_image | image_url: width: 600 | image_tag:
                  loading: 'lazy',
                  widths: '300, 400, 500, 600',
                  width: 300,
                  height: 400,
                  alt: featured_title
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'o-mobile-menu__featured-collection-placeholder' }}
              {%- endif -%}
            </div>
            <span class="o-mobile-menu__featured-collection-title">
              {%- render 'market-spelling', text: featured_title -%}
            </span>
          </a>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if featured_items != blank -%}
    <div class="o-mobile-menu__featured-collections">
      {{- featured_items -}}
    </div>
  {%- endif -%}
{%- endif -%}
