{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
CO-LAB CART BUNDLE
----------------------------------------------------------------------------------------------------------------------

Renders one Co-Lab bundle as a single review-style cream card on the cart page. Mirrors the "Mega Menu – 10"
design so the customer reviews their bundle here rather than inside the picker on the PDP.

Inputs:
* parent          — the parent ring line_item (has properties._bundle_role == 'parent')
* cart            — the cart object, used to locate child lines by shared _bundle_id
* index           — 0-based index, used to make checkbox ids unique when multiple bundles are in cart
----------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign bundle_id = parent.properties._bundle_id
  assign base_url = parent.properties._product_url | default: parent.product.url
  # Append ?edit_bundle=<id> so the picker can pre-populate from this cart line.
  if base_url contains '?'
    assign edit_url = base_url | append: '&edit_bundle=' | append: bundle_id
  else
    assign edit_url = base_url | append: '?edit_bundle=' | append: bundle_id
  endif

  assign total_price = parent.final_line_price
  for sibling in cart.items
    if sibling.properties._bundle_id == bundle_id and sibling.properties._bundle_role != 'parent'
      assign total_price = total_price | plus: sibling.final_line_price
    endif
  endfor

  assign confirm_id = 'co-lab-confirm-' | append: index

  # Build a lookup of stones (name → icon URL) so summary rows can show a swatch.
  assign all_stones = shop.metaobjects.birthstone.values
-%}

<c-co-lab-cart-bundle class="c-co-lab-cart-bundle"
                      data-bundle-id="{{ bundle_id }}"
                      data-parent-key="{{ parent.key | escape }}">
  {%- if colab_logo != blank -%}
    {{- colab_logo | image_url: width: 240 | image_tag: class: 'c-co-lab-cart-bundle__logo', loading: 'lazy', widths: '80,120,240', sizes: '120px', alt: 'CoLab' -}}
  {%- endif -%}

  <header class="c-co-lab-cart-bundle__header">
    <h2 class="c-co-lab-cart-bundle__title">{{ parent.product.title }}</h2>
    <p class="c-co-lab-cart-bundle__base-price">{{ parent.final_line_price | money_without_trailing_zeros }}</p>
  </header>

  {%- if parent.variant.title != 'Default Title' -%}
    <section class="c-co-lab-cart-bundle__group">
      <h3 class="c-co-lab-cart-bundle__group-title">Metal &amp; Sizing</h3>
      {%- for option in parent.product.options_with_values -%}
        {%- assign selected_value = parent.variant.options[forloop.index0] -%}
        <p class="c-co-lab-cart-bundle__row">
          <span class="c-co-lab-cart-bundle__row-label">{{ option.name }}:</span>
          <span class="c-co-lab-cart-bundle__row-value">{{ selected_value }}</span>
        </p>
      {%- endfor -%}
    </section>
  {%- endif -%}

  <section class="c-co-lab-cart-bundle__group">
    <h3 class="c-co-lab-cart-bundle__group-title">Customisation</h3>
    {%- for property in parent.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if first_char == '_' -%}{%- continue -%}{%- endif -%}
      {%- if property.last == blank -%}{%- continue -%}{%- endif -%}
      {%- liquid
        assign uplift = ''
        assign is_stone = false
        case property.first
          when 'Birthstone One', 'Birthstone Two'
            assign uplift = '+ £10'
            assign is_stone = true
          when 'Engraving'
            assign uplift = '+ £20'
        endcase

        assign swatch_url = ''
        if is_stone
          assign stone_name = property.last | split: ' - ' | first | strip
          for s in all_stones
            if s.name == stone_name and s.icon != blank
              assign swatch_url = s.icon | image_url: width: 60
              break
            endif
          endfor
        endif
      -%}
      <p class="c-co-lab-cart-bundle__row">
        <span class="c-co-lab-cart-bundle__row-label">{{ property.first }}:</span>
        <span class="c-co-lab-cart-bundle__row-value">
          {%- if swatch_url != blank -%}
            <span class="c-co-lab-cart-bundle__row-swatch" style="background-image: url('{{ swatch_url }}');"></span>
          {%- endif -%}
          {{ property.last }}
        </span>
        {%- if uplift != blank -%}
          <span class="c-co-lab-cart-bundle__row-uplift">{{ uplift }}</span>
        {%- endif -%}
      </p>
    {%- endfor -%}
  </section>

  <p class="c-co-lab-cart-bundle__total">{{ total_price | money_without_trailing_zeros }}</p>

  <label class="c-co-lab-cart-bundle__confirm" for="{{ confirm_id }}">
    <span class="c-co-lab-cart-bundle__confirm-label">I confirm this is my perfect potion</span>
    <input type="checkbox" id="{{ confirm_id }}" data-confirm-checkbox required>
  </label>
  <p class="c-co-lab-cart-bundle__confirm-note">
    I confirm that by ticking this box all the information I have provided is correct and I am aware that customisable pieces are non-refundable and non-exchangeable. I am aware that each ring is made to order and has longer delivery times.
  </p>

  <div class="c-co-lab-cart-bundle__actions">
    <a class="c-co-lab-cart-bundle__action c-co-lab-cart-bundle__action--secondary"
       href="{{ edit_url }}"
       data-action="edit-bundle">
      ← Edit My Order
    </a>
    <button type="submit"
            name="checkout"
            class="c-co-lab-cart-bundle__action c-co-lab-cart-bundle__action--primary"
            data-action="checkout">
      Checkout →
    </button>
  </div>

  <button type="button"
          class="c-co-lab-cart-bundle__remove"
          data-action="remove-bundle"
          aria-label="Remove bundle from cart"
          title="Remove this from cart">
    Remove from cart
  </button>
</c-co-lab-cart-bundle>
