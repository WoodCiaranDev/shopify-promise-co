{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
CO-LAB PICKER

Renders the Promise Co-Lab right-column picker for products tagged with metafield custom.product_type = 'co-lab'.
Replaces the standard block list. Multi-state UI: default → customising → stone grid → reviewing.

Inputs:
* product           — the Co-Lab ring
* product_form_id   — form ID used by the rest of the theme (sticky bar, payment button, etc.)
----------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- assign stones = shop.metaobjects.birthstone.values | sort: 'position' -%}
{%- assign first_variant = product.selected_or_first_available_variant -%}

<c-co-lab-picker
  class="c-co-lab-picker"
  data-product-id="{{ product.id }}"
  data-base-price="{{ first_variant.price }}"
  data-birthstone-price="1000"
  data-engraving-price="2000"
  data-birthstone-addon-handle="birthstone-addon"
  data-engraving-addon-handle="engraving-addon"
  data-product-url="{{ product.url }}"
>
  <product-form>
    {%- form 'product', product, id: product_form_id -%}
      <input type="hidden" name="id" value="{{ first_variant.id }}" data-variant-id>
      <span data-base-price-display hidden>{{ first_variant.price | money_without_trailing_zeros }}</span>

      <section class="c-co-lab-picker__card c-co-lab-picker__card--metal">
        <h2 class="c-co-lab-picker__section-title">Metal &amp; Sizing</h2>
        {% render 'variant-picker',
          product: product,
          form_id: product_form_id,
          context: 'main_product',
          selector_style: 'block',
          swatch_selector_style: 'swatch' %}
        <p class="c-co-lab-picker__size-guide">
          <a href="#size-guide-popup" title="Ring Size Guide">Unsure on sizing? &mdash; Size Guide Here</a>
        </p>
      </section>

      <section class="c-co-lab-picker__card c-co-lab-picker__card--custom" data-customisation>
        <h2 class="c-co-lab-picker__section-title">Customisation</h2>
        <p class="c-co-lab-picker__note">Personalised rings are non-refundable and non-exchangeable.</p>

        <div class="c-co-lab-picker__inner">
          <button type="button" class="c-co-lab-picker__stones-toggle" data-action="toggle-stones" aria-expanded="false">
            <span>Choose Hidden Birthstones</span>
            <span class="c-co-lab-picker__chev" aria-hidden="true">↓</span>
          </button>

          <div class="c-co-lab-picker__stones" data-stones hidden>
            {%- for slot in (1..2) -%}
              <div class="c-co-lab-picker__stone-row" data-slot="{{ slot }}">
                <p class="c-co-lab-picker__stone-label">
                  <span>Birthstone {% if slot == 1 %}One{% else %}Two{% endif %}:</span>
                  <span class="c-co-lab-picker__uplift">+ £10</span>
                </p>
                <button type="button" class="c-co-lab-picker__stone-select" data-action="open-grid" data-slot="{{ slot }}" aria-haspopup="dialog">
                  <span class="c-co-lab-picker__stone-swatch" data-stone-swatch="{{ slot }}" hidden></span>
                  <span class="c-co-lab-picker__stone-text" data-stone-text="{{ slot }}">Select Stone</span>
                  <span class="c-co-lab-picker__chev" aria-hidden="true">→</span>
                </button>
                <input type="hidden" name="properties[Birthstone {% if slot == 1 %}One{% else %}Two{% endif %}]" data-stone-input="{{ slot }}" value="" disabled>
              </div>
            {%- endfor -%}
          </div>

          {%- comment -%} Single grid lives at the end of the inner card; JS moves it inline next to the active stone row when opened. {%- endcomment -%}
          <div class="c-co-lab-picker__grid" data-grid hidden>
            <ul class="c-co-lab-picker__grid-list">
              {%- for stone in stones -%}
                <li>
                  <button type="button"
                          class="c-co-lab-picker__cell"
                          data-action="pick-stone"
                          data-name="{{ stone.name }}"
                          data-month="{{ stone.month }}"
                          data-icon="{% if stone.icon != blank %}{{ stone.icon | image_url: width: 120 }}{% endif %}">
                    <span class="c-co-lab-picker__cell-icon-wrap">
                      {%- if stone.icon != blank -%}
                        <img class="c-co-lab-picker__cell-icon"
                             src="{{ stone.icon | image_url: width: 120 }}"
                             alt=""
                             width="44" height="44" loading="lazy">
                      {%- endif -%}
                    </span>
                    <span class="c-co-lab-picker__cell-name">{{ stone.name }}</span>
                    <span class="c-co-lab-picker__cell-month">{{ stone.month }}</span>
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        </div>

        <div class="c-co-lab-picker__engraving">
          <div class="c-co-lab-picker__engraving-wrap">
            <input type="text"
                   id="{{ product_form_id }}-engraving"
                   class="c-co-lab-picker__engraving-input"
                   name="properties[Engraving]"
                   maxlength="12"
                   placeholder="Type Your Engraving Here"
                   data-engraving-input
                   disabled>
            <span class="c-co-lab-picker__engraving-uplift" aria-hidden="true">+ £20</span>
            <span class="c-co-lab-picker__engraving-arrow" aria-hidden="true">→</span>
          </div>
          <p class="c-co-lab-picker__engraving-count" data-engraving-count>0/12 Characters</p>
        </div>
      </section>

      <p class="c-co-lab-picker__error" data-error role="alert" aria-live="polite" hidden></p>

      <div class="c-co-lab-picker__actions">
        <button type="submit"
                class="c-co-lab-picker__action c-co-lab-picker__action--primary"
                data-action="submit"
                form="{{ product_form_id }}">
          Add to Cart →
        </button>
      </div>

      <script type="application/json" data-stones-json>
        [
          {%- for stone in stones -%}
            {
              "name": {{ stone.name | json }},
              "month": {{ stone.month | json }},
              "icon": {% if stone.icon != blank %}{{ stone.icon | image_url: width: 120 | json }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    {%- endform -%}
  </product-form>
</c-co-lab-picker>
