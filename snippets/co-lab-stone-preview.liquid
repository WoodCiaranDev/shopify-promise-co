{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
CO-LAB STONE PREVIEW

A live preview of the customer's chosen birthstones, composited in the browser from per-slot
layers: a full centre-stone photograph with a transparent halo overlay on top. 24 layers per
metal cover all 144 stone pairings.

Gated to a single product handle while this is a client test. Every other product, including
other Co-Lab products, renders the gallery exactly as before.

Inputs:
* product - the Co-Lab ring
* variant - optional modifier, e.g. 'compact' for the in-picker copy on mobile
----------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign stones = shop.metaobjects.birthstone.values | sort: 'position'
  assign metals = product.metafields.custom.metals.value | split: ','
-%}

<co-lab-stone-preview
  class="co-lab-stone-preview{% if variant %} co-lab-stone-preview--{{ variant }}{% endif %}"
  data-default-metal="{{ metals.first | strip | escape }}"
  data-default-centre="may"
  data-default-halo="april"
>
  <div class="co-lab-stone-preview__plate">
    <img class="co-lab-stone-preview__layer" data-layer="centre" alt="{{ product.title | escape }}">
    <img class="co-lab-stone-preview__layer" data-layer="halo" alt="" aria-hidden="true">
  </div>
  <p class="co-lab-stone-preview__caption" data-preview-caption></p>

  <script type="application/json" data-preview-config>
    {
      "metals": {
        {%- for metal in metals -%}
          {%- assign metal_name = metal | strip -%}
          {%- assign metal_key = metal_name | downcase | replace: ' ', '-' -%}
          {%- if metal_key contains 'silver' -%}{%- assign metal_key = 'silver' -%}{%- else -%}{%- assign metal_key = 'gold' -%}{%- endif -%}
          {{ metal_name | json }}: {{ metal_key | json }}{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      },
      "stones": {
        {%- for stone in stones -%}
          {%- assign stone_key = stone.month | downcase | strip -%}
          {{ stone.name | json }}: { "key": {{ stone_key | json }}, "month": {{ stone.month | json }} }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      },
      "urls": {
        {%- assign metal_keys = 'gold,silver' | split: ',' -%}
        {%- for mk in metal_keys -%}
          {{ mk | json }}: {
            {%- for stone in stones -%}
              {%- assign sk = stone.month | downcase | strip -%}
              {%- capture centre_asset -%}colab-heirloom-{{ mk }}-centre-{{ sk }}.jpg{%- endcapture -%}
              {%- capture halo_asset -%}colab-heirloom-{{ mk }}-halo-{{ sk }}.png{%- endcapture -%}
              {{ sk | json }}: {
                "centre": {{ centre_asset | asset_url | json }},
                "halo": {{ halo_asset | asset_url | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    }
  </script>
</co-lab-stone-preview>
