        "question_VRFrPK": {
          "type": "question",
          "settings": {
            "question": "Can I return my made to order piece?",
            "answer": "<p>Each Custom Lab piece is handcrafted specifically to your chosen specifications, including your selected design, metal, birthstones and/or engraving. Because of this, all Custom Lab orders are made to order and are final sale. </p><p>They cannot be returned or exchanged unless they arrive with a manufacturing fault.</p>"
          }
        },
        "question_JFrVHd": {
          "type": "question",
          "settings": {
            "question": "How long will it take to make?",
            "answer": "<p>All our rings are hand set and crafted by our master jewellers in 2-3 weeks, then they will dispatch as per your local shipping estimate.</p>"
          }
        }
