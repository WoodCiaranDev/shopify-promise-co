    "faq_EjjLir": {
      "type": "faq",
      "blocks": {
        "question_8yE4UU": {
          "type": "question",
          "settings": {
            "question": "Can I exchange my order?",
            "answer": "<p><strong>Ready To Wear:</strong><br/><br/>We want to make sure your item fits just right! If it doesn't, you're eligible for an exchange.</p><p>Please email <a href=\"mailto:info@thepromiseco.com\" target=\"_blank\" title=\"mailto:info@thepromiseco.com\"><strong>info@thepromiseco.com</strong></a><strong> </strong>to start the process</p><p>We will exchange any ready to wear item you are unhappy with if returned to us in its <strong>original, unaltered condition </strong>within <strong>30</strong> <strong>days </strong>from when you received it.<br/><br/><strong>Made To Order - Custom Lab:</strong><br/><br/>Because each Lab piece is made specifically for you, Lab orders are <strong>final sale.</strong> That means no returns or exchanges.<br/>You'll have <strong>60 minutes after ordering to amend your details</strong>; after that your piece is in production and can't be changed. So please check everything before you order.<br/><br/>And if a Lab piece ever arrives faulty, we'll always make it right — see our <a href=\"https://thepromiseco.com/pages/5-year-warranty\" title=\"https://thepromiseco.com/pages/5-year-warranty\">5-year warranty.</a></p><p><strong>Please see our </strong><a href=\"https://thepromiseco.com/policies/refund-policy\" title=\"https://thepromiseco.com/policies/refund-policy\"><strong>refund policy</strong></a><strong> for full details.</strong></p>"
          }
        },
        "question_Y4jb7k": {
          "type": "question",
          "settings": {
            "question": "Can I return my order?",
            "answer": "<p><strong>Ready To Wear Pieces: </strong><br/><br/>Yes! If your ring doesn't fit, or you simply don't love it, you can return it by emailing <a href=\"mailto:info@thepromiseco.com\" title=\"mailto:info@thepromiseco.com\"><strong>info@thepromiseco.com</strong></a><strong><br/></strong>We will refund any item you are unhappy with if returned to us in its original, unaltered condition within 30 days from when you received it.<br/><br/><strong>Made To Order - Custom Lab:</strong><br/><br/>Because each Lab piece is made specifically for you, Lab orders are <strong>final sale.</strong> That means no returns or exchanges.<br/>You'll have <strong>60 minutes after ordering to amend your details</strong>; after that your piece is in production and can't be changed. So please check everything before you order.<br/><br/>And if a Lab piece ever arrives faulty, we'll always make it right — see our <a href=\"https://thepromiseco.com/pages/5-year-warranty\" title=\"https://thepromiseco.com/pages/5-year-warranty\">5-year warranty.</a></p><p><strong>Please see our </strong><a href=\"https://thepromiseco.com/policies/refund-policy\" title=\"https://thepromiseco.com/policies/refund-policy\"><strong>refund policy</strong></a><strong> for full details.</strong></p>"
          }
        },
        "question_em8hhW": {
          "type": "question",
          "settings": {
            "question": "When will my refund be processed?",
            "answer": "<p>We will notify you once we’ve received and inspected your return, once your refund is approved please allow up to 10 working days for your bank to have cleared the transaction.</p><p>Please see our refund policy for full details.</p>"
          }
        },
        "question_9mjra6": {
          "type": "question",
          "settings": {
            "question": "I'm buying as a gift and your return window is not long enough, what can I do?",
            "answer": "<p>We appreciate that when it comes to unique gifts, you prefer to plan ahead. Before making your purchase, kindly reach out to us at <a>info@thepromiseco.com</a>, and we'll be happy to assist you.</p><p>If a longer timeframe is authorised, we can arrange this on an exchanges only basis (no cash refunds), provided that the ring passes our quality inspection upon return.</p>"
          }
        },
        "question_ypp9jd": {
          "type": "question",
          "settings": {
            "question": "Will you cover the cost of my return?",
            "answer": "<p>If it is proven that there is a fault with the good once inspected, we will credit you the cost of your return. There otherwise returns are at the cost of the customer.</p><p>Please see the refund policy for details.</p>"
          }
        }
      },
