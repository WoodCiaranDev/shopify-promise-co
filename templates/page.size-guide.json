    "faq_mGqRCd": {
      "type": "faq",
      "blocks": {
        "question_pTtC3c": {
          "type": "question",
          "settings": {
            "question": "How do I work out the right ring size?",
            "answer": "<p>You can now use our <a href=\"https://cdn.shopify.com/s/files/1/0572/2049/7548/files/size-guide-promise-co-130126.pdf?v=459384974267777057\" title=\"https://cdn.shopify.com/s/files/1/0572/2049/7548/files/size-guide-promise-co-130126.pdf?v=459384974267777057\">printable ring size guide</a> - simply place a ring you already own on top to find the match. If you don’t have one, a standard ring sizer (the keychain-style with metal loops) works perfectly too.</p><p>Once you’ve got your size, use our guide below to convert it, or just drop us an email and we’ll support at <a>info@thepromiseco.com</a></p><p></p>"
          }
        },
        "question_39kHFp": {
          "type": "question",
          "settings": {
            "question": "I don't know which ring to pick for a gift?",
            "answer": "<p>We have a great <a href=\"/collections/for-her\" title=\"Gifts for Her\">gift guide for her</a> and <a href=\"/collections/for-him\" title=\"For Him\">gift guide for him</a> where you can shop our most gifted pieces edit.</p><p>If you need personalised support on picking the perfect ring, email our team at <strong>info@thepromiseco.com</strong> and we will do our best to support.</p><p></p>"
          }
        },
        "question_k8h6gB": {
          "type": "question",
          "settings": {
            "question": "Is my ring under warranty?",
            "answer": "<p>At The Promise Ring Co. we are committed to providing you with<br/>exceptional service and ensuring that your purchase of your ring is a truly special and sentimental experience. We understand that these pieces aren't just jewellery; they are symbols of love, commitment, and cherished moments.</p><p>That's why we stand by our products and offer a 5-year guarantee to give you peace of mind.</p><p>For full warranty terms <a href=\"https://thepromiseringco.com/pages/2-year-warranty\" target=\"_blank\" title=\"https://thepromiseringco.com/pages/2-year-warranty\">click here</a></p>"
          }
        },
        "question_VnPF3N": {
          "type": "question",
          "settings": {
            "question": "I've damaged my special ring, what can I do?",
            "answer": "<p>We understand accidents happen and we know how precious all our pieces are to each customer.</p><p>Email us a picture of the damage to <strong>info@thepromiseco.com </strong>and we will do our best to support you with solutions</p>"
          }
        }
