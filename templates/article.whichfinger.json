    "rich_text_Ma7Tp8": {
      "type": "rich-text",
      "blocks": {
        "heading_HG4JYW": {
          "type": "heading",
          "settings": {
            "text": "What Does a Promise Ring Mean?",
            "heading_tag": "h1"
          }
        },
        "richtext_LYCDXD": {
          "type": "richtext",
          "settings": {
            "content": "<p>Before choosing the finger, it helps to define the promise. Despite the name, there is no single promise that  every promise ring represents.</p>"
          }
        }
      },
      "block_order": [
        "heading_HG4JYW",
        "richtext_LYCDXD"
      ],
      "name": "t:sections.rich_text.presets.rich_text.name",
      "settings": {
        "color_scheme": "scheme-9748e626-bd08-461a-ae84-54d07f2a89b9",
        "separate_section_with_border": false,
        "content_width": "sm",
        "text_position": "center",
        "remove_vertical_spacing": false,
        "use_baka_too_font": true,
