            "heading_tag": "h1"
          }
        },
        "richtext_8G6M8k": {
          "type": "richtext",
          "settings": {
            "content": "<p>Although ring fingers attract most of the attention, you have ten possible places to wear a promise ring. Here is how each works.</p>"
          }
        }
      },
