{%- if section.blocks.size > 0 -%}
  <div class="feature-strips color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% if section.settings.separate_section_with_border %} bordered-section{% endif %}">
    <div
      class="feature-strips__slider swiper"
      id="feature-strips-{{ section.id }}"
      data-feature-strips-slider
      data-autoplay="{{ section.settings.autoplay }}"
      data-autoplay-speed="{{ section.settings.autoplay_speed }}"
    >
      <div class="feature-strips__wrapper swiper-wrapper">
    {%- for block in section.blocks -%}
      {%- if block.type == 'strip' -%}
        {%- liquid
          assign is_reverse = false
          if block.settings.force_direction == 'text_left'
            assign is_reverse = false
          elsif block.settings.force_direction == 'image_left'
            assign is_reverse = true
          else
            assign mod = forloop.index | modulo: 2
            if mod == 0
              assign is_reverse = true
            endif
          endif
        -%}

        <div class="feature-strips__strip swiper-slide{% if is_reverse %} feature-strips__strip--reverse{% endif %}" {{ block.shopify_attributes }}>

          <div class="feature-strips__media"{% if section.settings.image_background_color != blank and section.settings.image_background_color != 'rgba(0,0,0,0)' %} style="background-color: {{ section.settings.image_background_color }};"{% endif %}>
            {%- if block.settings.image != blank -%}
              <picture class="feature-strips__picture">
                {%- if block.settings.mobile_image != blank -%}
                  <source media="(max-width: 699px)"
                          srcset="{{ block.settings.mobile_image | image_url: width: '500x' }} 500w, {{ block.settings.mobile_image | image_url: width: '700x' }} 700w, {{ block.settings.mobile_image | image_url: width: '900x' }} 900w"
                          width="{{ block.settings.mobile_image.width }}"
                          height="{{ block.settings.mobile_image.height }}">
                {%- endif -%}
                {{-
                  block.settings.image
                  | image_url: width: block.settings.image.width
                  | image_tag:
                    widths: '300,500,700,900,1100,1400,1700,2000',
                    sizes: '(min-width: 700px) min(50vw, var(--feature-strips-image-max-width, 640px)), 100vw',
                    class: 'feature-strips__image',
                    loading: 'lazy'
                -}}
              </picture>
            {%- endif -%}
          </div>

          <div class="feature-strips__content"{% if section.settings.text_background_color != blank and section.settings.text_background_color != 'rgba(0,0,0,0)' %} style="background-color: {{ section.settings.text_background_color }};"{% endif %}>
            <div class="container container--{{ section.settings.content_width }} feature-strips__content-inner">
              {%- if block.settings.subheading != blank -%}
                <p class="feature-strips__subheading h6">{{ block.settings.subheading }}</p>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <{{ block.settings.heading_tag }} class="feature-strips__heading {{ block.settings.heading_tag }}">{{ block.settings.heading }}</{{ block.settings.heading_tag }}>
              {%- endif -%}

              {%- if block.settings.content != blank -%}
                <div class="feature-strips__body">{{ block.settings.content }}</div>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <div class="feature-strips__cta button-group">
                  {%
                    render 'button',
                    content: block.settings.button_label,
                    href: block.settings.button_link,
                    style: block.settings.button_style
                  %}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
      </div>

      {%- if section.blocks.size > 1 -%}
        <div class="feature-strips__nav">
          <button type="button" class="feature-strips__arrow feature-strips__arrow--prev" data-feature-strips-prev aria-label="Previous slide">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="feature-strips__arrow feature-strips__arrow--next" data-feature-strips-next aria-label="Next slide">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .feature-strips__slider {
    position: relative;
  }

  .feature-strips .feature-strips__strip {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    height: auto;
  }

  @media (min-width: 700px) {
    .feature-strips .feature-strips__strip {
      grid-template-columns: 1fr 1fr;
    }

    .feature-strips .feature-strips__strip--reverse .feature-strips__media {
      order: 1;
    }
  }

  .feature-strips__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: #1a1a1a;
    cursor: pointer;
    transition: background 0.2s ease, opacity 0.2s ease;
  }

  .feature-strips__arrow:hover {
    background: #ffffff;
  }

  .feature-strips__arrow svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .feature-strips__nav {
    display: flex;
    justify-content: center;
    gap: 3.5rem;
    margin-top: 0;
    margin-bottom: 0.5rem;
    padding-bottom: 0.5rem;
  }

  @media (min-width: 700px) {
    .feature-strips__nav {
      display: contents;
    }

    .feature-strips__arrow {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2;
      width: 2.5rem;
      height: 2.5rem;
      background: rgba(255, 255, 255, 0.85);
    }

    .feature-strips__arrow--prev {
      left: 1rem;
    }

    .feature-strips__arrow--next {
      right: 1rem;
    }
  }

  .feature-strips__media {
    position: relative;
    min-height: 200px;
  }

  @media (min-width: 700px) {
    .feature-strips__media {
      min-height: 350px;
    }
  }

  .feature-strips__picture {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .feature-strips__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-strips__content {
    padding: 1.75rem 1rem 0.75rem;
  }

  /* Mobile: centre the caption copy (desktop keeps its default alignment). */
  .feature-strips__content-inner {
    text-align: center;
  }

  @media (min-width: 700px) {
    .feature-strips__content {
      padding: 4rem 1.5rem;
    }

    .feature-strips__content-inner {
      text-align: left;
    }
  }

  .feature-strips__content-inner > * + * {
    margin-top: 1rem;
  }

  .feature-strips__subheading {
    letter-spacing: 0.18em;
    margin: 0;
  }

  .feature-strips__heading {
    margin: 0;
  }

  .feature-strips__cta {
    margin-top: 2rem;
  }
{% endstylesheet %}

<script>
  (function () {
    function initFeatureStrips(slider) {
      if (!slider || typeof Swiper === 'undefined') return;
      if (slider.swiper) return;

      var slideCount = slider.querySelectorAll('.swiper-slide').length;
      if (slideCount < 2) return;

      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var autoplayOn = slider.dataset.autoplay === 'true' && !reduceMotion;
      var speed = parseInt(slider.dataset.autoplaySpeed, 10) || 5;

      // One full strip per view (no fractional peek/centred slides — that combination loops
      // janky in Swiper 11). autoHeight lets the slider adapt smoothly to each strip's height.
      new Swiper(slider, {
        loop: true,
        speed: 600,
        grabCursor: true,
        slidesPerView: 1,
        spaceBetween: 0,
        autoHeight: true,
        autoplay: autoplayOn
          ? { delay: speed * 1000, disableOnInteraction: false, pauseOnMouseEnter: true }
          : false,
        navigation: {
          prevEl: slider.querySelector('[data-feature-strips-prev]'),
          nextEl: slider.querySelector('[data-feature-strips-next]')
        }
      });
    }

    function initAll() {
      document.querySelectorAll('[data-feature-strips-slider]').forEach(initFeatureStrips);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }

    document.addEventListener('shopify:section:load', function (event) {
      var section = event.target;
      if (!section) return initAll();
      section.querySelectorAll('[data-feature-strips-slider]').forEach(initFeatureStrips);
    });
  })();
</script>

{% schema %}
{
  "name": "Lab feature strips",
  "class": "shopify-section--feature-strips",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "color",
      "id": "text_background_color",
      "label": "Text panel background",
      "default": "#f2eee7"
    },
    {
      "type": "color",
      "id": "image_background_color",
      "label": "Image panel background",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Text container width",
      "options": [
        { "value": "xs", "label": "t:global.sizes.x_small" },
        { "value": "sm", "label": "t:global.sizes.small" },
        { "value": "md", "label": "t:global.sizes.medium" },
        { "value": "lg", "label": "t:global.sizes.large" }
      ],
      "default": "sm"
    },
    {
      "type": "range",
      "id": "image_max_width",
      "label": "Image maximum width",
      "min": 200,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "header",
      "content": "Slider"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-advance slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Seconds between slides",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "strip",
      "name": "Strip",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image (optional)"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Eyebrow"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Heading"
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "Heading style",
          "options": [
            { "value": "h2", "label": "H2" },
            { "value": "h3", "label": "H3" },
            { "value": "h4", "label": "H4" }
          ],
          "default": "h2"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Body",
          "default": "<p>Paragraph about the types of rings you can get engraved, how it works etc...</p>"
        },
        {
          "type": "select",
          "id": "force_direction",
          "label": "Direction",
          "options": [
            { "value": "auto", "label": "Auto (alternate)" },
            { "value": "text_left", "label": "Text left, image right" },
            { "value": "image_left", "label": "Image left, text right" }
          ],
          "default": "auto"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "options": [
            { "value": "solid", "label": "t:global.text.button_style_options.solid" },
            { "value": "outline", "label": "t:global.text.button_style_options.outline" }
          ],
          "default": "outline"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lab feature strips",
      "blocks": [
        { "type": "strip", "settings": { "heading": "Engraving" } },
        { "type": "strip", "settings": { "heading": "Inner Birth Stones" } },
        { "type": "strip", "settings": { "heading": "Engraving" } }
      ]
    }
  ]
}
{% endschema %}
