{%- liquid
  assign show_country_selector = false
  assign show_locale_selector = false

  if section.settings.show_country_selector and localization.available_countries.size > 1
    assign show_country_selector = true
  endif

  if section.settings.show_locale_selector and localization.available_languages.size > 1
    assign show_locale_selector = true
  endif

-%}

<div class="promise-footer color-scheme color-scheme--{{ section.settings.color_scheme.id }}{% unless section.settings.remove_vertical_spacing %} section-spacing{% endunless %}{% if section.settings.separate_section_with_border %} bordered-section{% endif %}"
     style="--promise-footer-media-width: {{ section.settings.media_width }}%;{% if section.settings.background_color != blank and section.settings.background_color != 'rgba(0,0,0,0)' %} background-color: {{ section.settings.background_color }};{% endif %}{% if section.settings.text_color != blank and section.settings.text_color != 'rgba(0,0,0,0)' %} --promise-footer-text: {{ section.settings.text_color }}; color: {{ section.settings.text_color }};{% endif %}">
  <div class="container container--{{ section.settings.content_width }}">
    <div class="promise-footer__inner">
      {%- comment -%}
      ------------------------------------------------------------------------------------------------------------------
      LIFESTYLE IMAGE — a single pre-composed image, corner radius baked into the artwork
      ------------------------------------------------------------------------------------------------------------------
      {%- endcomment -%}

      {%- if section.settings.image != blank -%}
        <div class="promise-footer__media{% unless section.settings.show_image_mobile %} promise-footer__media--desktop{% endunless %}">
          {%- if section.settings.image_link != blank -%}
            <a href="{{ section.settings.image_link }}" class="promise-footer__media-link">
          {%- endif -%}

          {{-
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '400,600,800,1000,1400',
              sizes: '(max-width: 999px) 100vw, 40vw',
              loading: 'lazy',
              class: 'promise-footer__image'
          -}}

          {%- if section.settings.image_link != blank -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="promise-footer__content">
        {%- comment -%}
        ----------------------------------------------------------------------------------------------------------------
        TOP ROW — monogram, plus the utility group hoisted alongside it on mobile only
        ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

        <div class="promise-footer__top">
          {%- if section.settings.show_monogram -%}
            <div class="promise-footer__monogram">
              {%- if section.settings.monogram != blank -%}
                {{-
                  section.settings.monogram
                  | image_url: width: 200
                  | image_tag:
                    widths: '50,75,100,150,200',
                    sizes: '50px',
                    loading: 'lazy',
                    class: 'promise-footer__monogram-image'
                -}}
              {%- else -%}
                <img src="{{ 'promise-monogram.svg' | asset_url }}"
                     alt="{{ shop.name | escape }}"
                     width="50"
                     height="50"
                     loading="lazy"
                     class="promise-footer__monogram-image">
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- render 'promise-footer-utility',
            variant: 'mobile',
            show_country_selector: show_country_selector,
            show_locale_selector: show_locale_selector,
            show_country_name: section.settings.show_country_name,
            show_country_flag: section.settings.show_country_flag,
            show_payment_icons: section.settings.show_payment_icons,
            payment_types: section.settings.payment_types,
            amex_icon: section.settings.amex_icon
          -%}
        </div>

          <div class="promise-footer__main">
          {%- if section.blocks.size > 0 -%}
            <div class="promise-footer__columns">
              {%- for block in section.blocks -%}
                {%- capture column_content -%}
                  {%- case block.type -%}
                    {%- when 'links' -%}
                      {%- assign menu = block.settings.menu -%}

                      {%- if menu != blank and menu.links.size > 0 -%}
                        {%- if block.settings.title != blank -%}
                          <p class="promise-footer__column-title">{{ block.settings.title | default: menu.title }}</p>
                        {%- endif -%}

                        <ul class="promise-footer__links unstyled-list" role="list">
                          {%- for link in menu.links -%}
                            <li>
                              <a href="{{ link.url }}" class="promise-footer__link">{{ link.title }}</a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}

                    {%- when 'text' -%}
                      {%- if block.settings.title != blank -%}
                        <p class="promise-footer__column-title">{{ block.settings.title }}</p>
                      {%- endif -%}

                      {%- if block.settings.content != blank -%}
                        <div class="promise-footer__text">{{ block.settings.content }}</div>
                      {%- endif -%}
                  {%- endcase -%}
                {%- endcapture -%}

                {%- if column_content != blank -%}
                  <div class="promise-footer__column promise-footer__column--{{ block.type }}"
                       style="--promise-footer-column-order: {{ forloop.index | times: 10 }};"
                       {{ block.shopify_attributes }}>
                    {{- column_content -}}
                  </div>
                {%- endif -%}
              {%- endfor -%}

              {%- if section.settings.show_social_media -%}
                <div class="promise-footer__socials promise-footer__socials--mobile">
                  {%- render 'social-media', layout: 'list' -%}
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

        {%- comment -%}
        ----------------------------------------------------------------------------------------------------------------
        ASIDE — brand lockup, then the utility group and social icons, with the copyright beneath both.
        ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

        <div class="promise-footer__bottom">
        <div class="promise-footer__aside">
          <div class="promise-footer__brand">
            {%- if section.settings.show_brand_lockup -%}
              {%- if section.settings.brand_lockup != blank -%}
                <div class="promise-footer__lockup">
                  {{-
                    section.settings.brand_lockup
                    | image_url: width: 600
                    | image_tag:
                      widths: '160,240,320,480,600',
                      sizes: '160px',
                      loading: 'lazy',
                      class: 'promise-footer__lockup-image'
                  -}}
                </div>
              {%- elsif section.settings.brand_text != blank -%}
                <p class="promise-footer__lockup-text">{{ section.settings.brand_text }}</p>
              {%- endif -%}
            {%- endif -%}

          </div>

          <div class="promise-footer__aside-end">
            {%- render 'promise-footer-utility',
              variant: 'desktop',
              show_country_selector: show_country_selector,
              show_locale_selector: show_locale_selector,
              show_country_name: section.settings.show_country_name,
              show_country_flag: section.settings.show_country_flag,
              show_payment_icons: section.settings.show_payment_icons,
              payment_types: section.settings.payment_types,
              amex_icon: section.settings.amex_icon
            -%}

            {%- if section.settings.show_social_media -%}
              <div class="promise-footer__socials promise-footer__socials--desktop">
                {%- render 'social-media', layout: 'list' -%}
              </div>
            {%- endif -%}
          </div>
        </div>

        {%- comment -%}
        ----------------------------------------------------------------------------------------------------------------
        LEGAL — a full-width row beneath the aside, so it clears both the brand lockup and the
        utility/social group rather than hanging off one of them.
        ----------------------------------------------------------------------------------------------------------------
        {%- endcomment -%}

        {%- if section.settings.copyright_text != blank -%}
          <p class="promise-footer__copyright">{{ section.settings.copyright_text }}</p>
        {%- endif -%}
        </div>
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .promise-footer {
    color: var(--promise-footer-text, inherit);
  }

  .promise-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  .promise-footer__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .promise-footer__content {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .promise-footer__main {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    justify-content: space-between;
    flex: 1 1 auto;
    min-width: 0;
  }

  .promise-footer__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .promise-footer__monogram-image {
    display: block;
    width: 50px;
    height: auto;
  }

  .promise-footer__utility {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .promise-footer__utility--desktop {
    display: none;
  }

  .promise-footer__utility--mobile {
    align-items: flex-end;
    text-align: end;
  }

  .promise-footer__utility--mobile .promise-payment-icons {
    justify-content: flex-end;
  }

  .promise-payment-icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
  }

  .promise-payment-icons svg,
  .promise-payment-icons__custom {
    display: block;
    width: auto;
    height: var(--promise-footer-payment-icon-height, 24px);
  }

  .promise-footer__socials {
    --social-media-icon-size: 1.625rem;
    --social-media-list-gap: 0.75rem 1.5rem;
  }

  .promise-footer__columns {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    flex: 1 1 auto;
  }

  .promise-footer__column {
    order: var(--promise-footer-column-order, 10);
  }

  .promise-footer__column-title {
    margin: 0 0 1rem;
    font-family: "covik-sans", var(--text-font-family);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .promise-footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;
  }

  .promise-footer__link,
  .promise-footer__text a {
    color: inherit;
    text-decoration: none;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .promise-footer__link:hover,
  .promise-footer__text a:hover {
    text-decoration: underline;
  }

  .promise-footer__text {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .promise-footer__text p {
    margin: 0 0 0.375rem;
  }

  .promise-footer__localization .localization-toggle {
    white-space: nowrap;
  }

  .promise-footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .promise-footer__aside {
    display: flex;
    flex-direction: column;
    row-gap: 1.5rem;
    column-gap: 0;
  }

  .promise-footer__lockup-image {
    display: block;
    width: 160px;
    height: auto;
    margin-block-end: 0.75rem;
  }

  .promise-footer__lockup-text {
    margin: 0 0 0.75rem;
    font-family: "covik-sans", var(--text-font-family);
    font-size: 1.125rem;
    letter-spacing: 0.01em;
    text-transform: none;
  }

  .promise-footer__copyright {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.5;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    opacity: 1;
    text-align: start;
  }

  .promise-footer__aside-end {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .promise-footer__socials--mobile {
    order: 25;
  }

  .promise-footer__socials--desktop {
    display: none;
  }

  @media screen and (min-width: 1000px) {
    .promise-footer__inner {
      grid-template-columns: var(--promise-footer-media-width, 40%) 1fr;
      gap: 4rem;
      align-items: stretch;
    }

    .promise-footer__content {
      flex-direction: row;
    }

    .promise-footer__columns {
      flex-direction: row;
      gap: 3rem;
    }

    .promise-footer__top {
      flex: 0 0 auto;
      display: block;
    }

    .promise-footer__utility--mobile {
      display: none;
    }

    .promise-footer__utility--desktop {
      display: flex;
      align-items: flex-end;
      text-align: end;
    }

    .promise-footer__utility--desktop .promise-payment-icons {
      justify-content: flex-end;
    }

    .promise-footer__aside-end {
      align-items: flex-end;
      flex: 0 0 auto;
    }

    .promise-footer__aside-end .promise-payment-icons {
      flex-wrap: nowrap;
    }

    .promise-footer__column {
      flex: 1 1 0;
      order: 0;
    }

    .promise-footer__aside {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
    }

    .promise-footer__socials--mobile {
      display: none;
    }

    .promise-footer__socials--desktop {
      display: block;
    }
  }

  @media screen and (max-width: 999px) {
    .promise-footer__media--desktop {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promise footer",
  "class": "shopify-section--promise-footer shopify-section--footer",
  "tag": "footer",
  "max_blocks": 4,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:global.sizes.content_width",
      "options": [
        { "value": "sm", "label": "t:global.sizes.small" },
        { "value": "md", "label": "t:global.sizes.medium" },
        { "value": "lg", "label": "t:global.sizes.large" }
      ],
      "default": "lg"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background colour (overrides scheme)",
      "default": "#f1eee7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#1a1a1a"
    },
    {
      "type": "checkbox",
      "id": "remove_vertical_spacing",
      "label": "t:global.spacing.remove_vertical_spacing",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "separate_section_with_border",
      "label": "t:global.section.separate_section_with_border",
      "default": false
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle image",
      "info": "Use a pre-composed image with the logo overlay and rounded corners already applied."
    },
    {
      "type": "url",
      "id": "image_link",
      "label": "Image link"
    },
    {
      "type": "checkbox",
      "id": "show_image_mobile",
      "label": "Show image on mobile",
      "info": "Hidden on mobile in the original design.",
      "default": false
    },
    {
      "type": "range",
      "id": "media_width",
      "label": "Image width (desktop)",
      "min": 25,
      "max": 55,
      "step": 1,
      "unit": "%",
      "default": 40
    },
    {
      "type": "header",
      "content": "Branding"
    },
    {
      "type": "checkbox",
      "id": "show_monogram",
      "label": "Show monogram",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "monogram",
      "label": "Monogram",
      "info": "Leave empty to use the bundled monogram SVG."
    },
    {
      "type": "checkbox",
      "id": "show_brand_lockup",
      "label": "Show brand lockup",
      "default": true
    },
    {
      "type": "text",
      "id": "brand_text",
      "label": "Brand lockup text",
      "info": "Shown above the copyright. Renders in Covik Sans.",
      "default": "Wearable Stories™"
    },
    {
      "type": "image_picker",
      "id": "brand_lockup",
      "label": "Brand lockup image",
      "info": "Optional. Overrides the text above if you need the exact supplied artwork."
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright line",
      "default": "© 2026 All rights reserved - The Promise Ring Co LTD. 13982489"
    },
    {
      "type": "header",
      "content": "Payment badges"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment badges",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_types",
      "label": "Badges to show",
      "info": "Comma-separated, in display order. Options include visa, master, american_express, paypal, klarna, apple_pay, google_pay, shopify_pay, maestro, discover.",
      "default": "visa,apple_pay,google_pay,master,american_express,shopify_pay"
    },
    {
      "type": "image_picker",
      "id": "amex_icon",
      "label": "Custom American Express badge",
      "info": "Optional. Replaces the badge Shopify supplies, which the client found unclear."
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "checkbox",
      "id": "show_social_media",
      "label": "t:sections.footer.show_social_media",
      "info": "t:sections.footer.show_social_media_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:global.localization.country_region_selector_category",
      "info": "t:global.localization.country_region_selector_category_info"
    },
    {
      "type": "checkbox",
      "id": "show_country_selector",
      "label": "t:global.localization.show_country_region_selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_name",
      "label": "t:global.localization.show_country_name",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_country_flag",
      "label": "t:global.localization.show_country_flag",
      "default": true
    },
    {
      "type": "header",
      "content": "t:global.localization.language_selector_category",
      "info": "t:global.localization.language_selector_category_info"
    },
    {
      "type": "checkbox",
      "id": "show_locale_selector",
      "label": "t:global.localization.show_locale_selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Menu",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.blocks.links.menu",
          "default": "footer"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Column title",
          "default": "Footer menu"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column title",
          "default": "Contact us"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "t:global.text.content",
          "default": "<p>info@thepromiseco.com</p><p>The Promise Ring Co Ltd.</p><p>Company no. 13982489</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promise footer",
      "blocks": [
        { "type": "links", "settings": { "menu": "help-support", "title": "Help & Support" } },
        { "type": "links", "settings": { "menu": "policies", "title": "Policies" } },
        { "type": "links", "settings": { "menu": "footer", "title": "Footer menu" } }
      ]
    }
  ]
}
{% endschema %}
