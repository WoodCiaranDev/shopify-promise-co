{%- liquid
  assign active_values_count = 0

  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.max_value.value != blank or filter.min_value.value != blank
        assign active_values_count = active_values_count | plus: 1
      endif
    else
      assign active_values_count = active_values_count | plus: filter.active_values.size
    endif
  endfor

  if section.settings.quick_links_menu.links.size > 0 or section.settings.show_filters and collection.filters.size > 0
    assign show_filters = true
  else
    assign show_filters = false
  endif

  # Custom Lab collection: never show the filter toolbar/button (curated grid, not faceted).
  if template.suffix == 'co-lab'
    assign show_filters = false
  endif

  assign products_desktop_grid_mode = section.settings.products_size_desktop

  if section.settings.products_per_row_mobile == '1'
    assign products_mobile_grid_mode = 'large'
  else
    assign products_mobile_grid_mode = 'medium'
  endif

  assign show_filter_list = false
  if show_filters and section.settings.show_filters
    assign show_filter_list = true
  endif

  if show_filters or section.settings.show_sort_by
    assign show_facets_drawer = true
  else
    assign show_facets_drawer = false
  endif

  assign has_made_to_order = false
  unless template.suffix contains 'co-lab'
    for tag in collection.all_tags
      assign tag_handle = tag | handle
      if tag_handle == 'made-to-order'
        assign has_made_to_order = true
        break
      endif
    endfor
  endunless
-%}

{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
CSS
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<style>
  #shopify-section-{{ section.id }} {
    --product-list-horizontal-spacing-factor: {{ section.settings.horizontal_spacing_factor }};
    --product-list-vertical-spacing-factor: {{ section.settings.vertical_spacing_factor }};

    {% comment %}On mobile, it's simple! No sidebar or whatever{% endcomment %}
    --collection-items-per-row-medium: 2;
    --collection-items-per-row-large: 1;
  }

  #shopify-section-{{ section.id }} .product-list {
    --product-list-max-items-per-row-allowed: 99 !important; {% comment %}On collection page, we explicitly set a number of items so we don't want this{% endcomment %}
  }

  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} {
      {% comment %}On tablet, we do not have any sidebar, so we can fix it{% endcomment %}
      --collection-items-per-row-compact: 4;
      --collection-items-per-row-medium: 3;
      --collection-items-per-row-large: 2;
    }
  }

  @media screen and (min-width: 1000px) {
    #shopify-section-{{ section.id }} {
      {%- comment -%}Starting from 1000px it starts to get funky, as we can have or not the sidebar{%- endcomment -%}

      {%- if section.settings.filter_layout == 'sidebar' and show_filters -%}
        --collection-items-per-row-compact: 4;
        --collection-items-per-row-medium: 3;
        --collection-items-per-row-large: 2;
      {%- else -%}
        --collection-items-per-row-compact: 6;
        --collection-items-per-row-medium: 4;
        --collection-items-per-row-large: 3;
      {%- endif -%}
    }

    #shopify-section-{{ section.id }} .collection {
      {%- if section.settings.filter_layout == 'sidebar' and show_filters -%}
        --collection-grid-template: var(--collection-sidebar-width, 0) minmax(0,1fr);
      {%- endif -%}
    }
  }

  @media screen and (min-width: 1400px) {
    #shopify-section-{{ section.id }} {
      {%- comment -%}Starting from 1400px we can afford having more content even in sidebar mode{%- endcomment -%}

      {%- if section.settings.filter_layout == 'sidebar' and show_filters -%}
        --collection-items-per-row-compact: 6;
        --collection-items-per-row-medium: 4;
        --collection-items-per-row-large: 3;
      {%- endif -%}
    }
  }
</style>

{%- comment -%}
------------------------------------------------------------------------------------------------------------------------
LIQUID
------------------------------------------------------------------------------------------------------------------------
{%- endcomment -%}

<div class="color-scheme color-scheme--{{ section.settings.color_scheme.id }}">
  <div class="container">
    <div class="v-stack gap-6 sm:gap-12">
      {%- if collection.all_products_count == 0 -%}
        <div class="empty-state">
          <div class="prose">
            <h1 class="h4">{{ collection.title }}</h1>
            <p>{{ 'collection.general.empty_collection' | t }}</p>

            {%- assign button_content = 'collection.general.continue_shopping' | t -%}
            {%- render 'button', href: routes.all_products_collection_url, size: 'xl', content: button_content -%}
          </div>
        </div>
      {%- else -%}
        {%- if show_facets_drawer or section.settings.show_results_count -%}
          <height-observer variable="collection-toolbar" class="collection-toolbar collection-toolbar--facets full-bleed{% if section.settings.filter_layout == 'sidebar' and show_filters %} md:hidden{% endif %}">
            <div class="collection-toolbar__button-list">
              {%- if show_facets_drawer -%}
                <div class="collection-toolbar__button-container">
                  <button type="button" aria-controls="facets-drawer" class="collection-toolbar__button collection-toolbar__facets-button w-full">
                    <span class="text-with-icon">
                      {{- 'collection.faceting.filter_and_sort' | t }}{% if active_values_count > 0 %} ({{ active_values_count }}){% endif -%}
                      {%- render 'icon' with 'filter-sliders' -%}
                    </span>
                  </button>
                </div>
              {%- endif -%}
            </div>

            {%- if section.settings.show_results_count -%}
              <p class="collection-toolbar__products-count h6 text-subdued md-max:hidden">
                {{ 'collection.products_count' | t: count: collection.products_count }}
              </p>
            {%- endif -%}
          </height-observer>
        {%- endif -%}

        <div class="collection">
          {%- paginate collection.products by section.settings.products_per_page -%}
            {%- if show_facets_drawer -%}
              <facets-drawer id="facets-drawer" class="facets-drawer drawer drawer--sm color-scheme color-scheme--dialog{% if section.settings.filter_layout == 'sidebar' and show_filters %} md:hidden{% endif %}">
                <p class="h4" slot="header">{{ 'collection.faceting.filter_and_sort' | t }}</p>

                {%- render 'facets', results: collection, show_filters: show_filter_list, show_sort: section.settings.show_sort_by, show_personalise: has_made_to_order, open_filters_by_default: section.settings.open_filters_by_default, update_on_change: false, quick_links_menu: section.settings.quick_links_menu, context: 'drawer' -%}

                <div slot="footer" class="facets-drawer__footer">
                  <a href="{{ collection.url }}{% if collection.sort_by != blank %}?sort_by={{ collection.sort_by }}{% endif %}" class="button button--outline">{{ 'collection.faceting.clear_filters' | t }}</a>

                  {%- assign button_content = 'collection.faceting.apply_filters' | t -%}

                  <dialog-close-button class="contents">
                    {%- render 'button', type: 'button', content: button_content -%}
                  </dialog-close-button>
                </div>
              </facets-drawer>
            {%- endif -%}

            {%- if show_filters -%}
              {%- if section.settings.filter_layout == 'sidebar' -%}
                <safe-sticky class="facets-sidebar md-max:hidden">
                  {%- render 'facets', results: collection, show_filters: show_filter_list, show_sort: section.settings.show_sort_by, show_personalise: has_made_to_order, open_filters_by_default: section.settings.open_filters_by_default, update_on_change: true, quick_links_menu: section.settings.quick_links_menu, context: 'sidebar' -%}
                </safe-sticky>
              {%- endif -%}
            {%- endif -%}

            {%- if collection.products_count == 0 -%}
              <div class="empty-state">
                <div class="v-stack gap-4">
                  <p>{{ 'collection.faceting.no_results' | t }}</p>

                  {%- assign button_content = 'collection.faceting.clear_filters' | t -%}

                  <facet-link>
                    {%- render 'button', href: collection.url, content: button_content -%}
                  </facet-link>
                </div>
              </div>
            {%- else -%}
              <div class="collection__main">
                {%- render 'active-facets', results: collection -%}

                <product-list id="product-list-{{ section.id }}" class="product-list" collection-mobile-layout="{{ products_mobile_grid_mode }}" collection-desktop-layout="{{ products_desktop_grid_mode }}">
                  {%- liquid
                    # Intro card content is editable per-collection via metafields, falling back to the section settings.
                    assign cm = collection.metafields.custom
                    assign ic_image = cm.intro_card_image.value | default: section.settings.intro_card_image
                    assign ic_logo = cm.intro_card_logo.value | default: section.settings.intro_card_logo
                    assign ic_heading = cm.intro_card_heading.value | default: section.settings.intro_card_heading
                    assign ic_text = cm.intro_card_text.value | default: section.settings.intro_card_text
                    assign ic_btn_label = cm.intro_card_button_label.value | default: section.settings.intro_card_button_label
                    assign ic_btn_link = cm.intro_card_button_link.value | default: section.settings.intro_card_button_link
                    assign ic_white = section.settings.intro_card_white_bg
                    if cm.intro_card_white_bg.value != blank
                      assign ic_white = cm.intro_card_white_bg.value
                    endif

                    # Position: 'first' slot or 'third' slot (default). Per-collection metafield overrides the section setting.
                    assign ic_position = section.settings.intro_card_position | default: 'third'
                    if cm.intro_card_position.value != blank
                      assign ic_position = cm.intro_card_position.value
                    endif
                    assign ic_index = 3
                    if ic_position == 'first'
                      assign ic_index = 1
                    endif

                    assign show_intro = false
                    if section.settings.show_intro_card and paginate.current_page == 1
                      if ic_image != blank or ic_logo != blank or ic_heading != blank or ic_text != blank or ic_btn_label != blank
                        assign show_intro = true
                      endif
                    endif
                  -%}
                  {%- capture intro_card_html -%}
                    {%- if ic_image != blank -%}
                      <div class="collection-intro-card collection-intro-card--image" data-intro-card>
                        {{
                          ic_image
                          | image_url: width: 800
                          | image_tag:
                            widths: '300,450,600,800',
                            sizes: '(min-width: 750px) 25vw, 50vw',
                            class: 'collection-intro-card__image',
                            loading: 'lazy'
                        }}
                      </div>
                    {%- else -%}
                    <div class="collection-intro-card{% if ic_white %} collection-intro-card--white{% endif %}" data-intro-card>
                      <div class="collection-intro-card__inner">
                        {%- if ic_logo != blank -%}
                          {{
                            ic_logo
                            | image_url: width: 320
                            | image_tag:
                              widths: '120,180,240,320',
                              sizes: '160px',
                              class: 'collection-intro-card__logo',
                              loading: 'lazy'
                          }}
                        {%- endif -%}
                        {%- if ic_heading != blank -%}
                          <p class="collection-intro-card__heading">{{ ic_heading }}</p>
                        {%- endif -%}
                        {%- if ic_text != blank -%}
                          <div class="collection-intro-card__text">{{ ic_text }}</div>
                        {%- endif -%}
                        {%- if ic_btn_label != blank -%}
                          {%- render 'button', content: ic_btn_label, href: ic_btn_link, style: 'outline' -%}
                        {%- endif -%}
                      </div>
                    </div>
                    {%- endif -%}
                  {%- endcapture -%}
                  {%- assign intro_rendered = false -%}
                  {%- for product in collection.products -%}
                    {%- if show_intro and intro_rendered == false and forloop.index == ic_index -%}
                      {{ intro_card_html }}
                      {%- assign intro_rendered = true -%}
                    {%- endif -%}
                    {%- render 'color-variant', product: product, reveal: settings.stagger_products_apparition, position: forloop.index, hide_product_information: section.settings.hide_product_information, stacked: true -%}
                  {%- endfor -%}
                  {%- if show_intro and intro_rendered == false -%}
                    {{ intro_card_html }}
                  {%- endif -%}
                </product-list>

                {%- if show_intro -%}
                  <script>
                    (function () {
                      var section = document.getElementById('shopify-section-{{ section.id }}');
                      if (!section) return;

                      // Pin the intro card to the top-right of row 1 on desktop, and to the
                      // 4th slot (row 2, right) on mobile — measured from the live column count,
                      // because the product grid uses repeat(auto-fit, ...) not fixed columns.
                      function targetPosition(cols) {
                        if (cols >= 3) return cols;   // 4 cols -> 4th, 3 cols -> 3rd (row-1 right)
                        if (cols === 2) return 4;     // mobile -> row-2 right
                        return 2;                     // single column fallback
                      }

                      // Real grid cells only — skip zero-size sentinels/sizers the product-list
                      // element injects (those broke earlier top-based measurements).
                      function gridCells(list) {
                        return Array.prototype.slice.call(list.children).filter(function (el) {
                          return el.offsetWidth > 0 && el.offsetHeight > 0;
                        });
                      }

                      // Columns = how many cells share the first row, detected by offsetLeft
                      // increasing until it wraps. offsetLeft is the layout position, so it's
                      // immune to the cards' reveal transforms and to vertical alignment.
                      function columnCount(cells) {
                        if (!cells.length) return 1;
                        var firstLeft = cells[0].offsetLeft;
                        var n = 1;
                        for (var i = 1; i < cells.length; i++) {
                          if (cells[i].offsetLeft <= firstLeft + 1) break; // wrapped to next row
                          n++;
                        }
                        return n;
                      }

                      function place() {
                        var list = section.querySelector('product-list');
                        if (!list) return;
                        var card = list.querySelector('[data-intro-card]');
                        if (!card) return;
                        var cells = gridCells(list);
                        if (cells.length < 2) return;
                        var cols = columnCount(cells);
                        var products = cells.filter(function (el) { return el !== card; });
                        if (!products.length) return;
                        var pos = Math.min(targetPosition(cols), products.length + 1); // 1-based
                        var ref = products[pos - 1] || null;
                        if (card.nextElementSibling !== ref && card !== ref) list.insertBefore(card, ref);
                      }

                      function init() {
                        place();
                        var list = section.querySelector('product-list');
                        // ResizeObserver fires once layout settles and on every breakpoint change,
                        // which corrects the early/stale placement reliably.
                        if (list && window.ResizeObserver) {
                          new ResizeObserver(function () { place(); }).observe(list);
                        }
                      }

                      if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', init);
                      } else {
                        init();
                      }
                      window.addEventListener('load', place);
                      window.addEventListener('resize', place);
                      document.addEventListener('shopify:section:load', function (e) {
                        if (e.detail && e.detail.sectionId === '{{ section.id }}') place();
                      });
                    })();
                  </script>
                {%- endif -%}

                {%- render 'pagination', paginate: paginate, facet: true -%}
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "class": "shopify-section--main-collection",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:global.colors.scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "hide_product_information",
      "label": "t:global.product_list.hide_product_information",
      "info": "t:global.product_list.hide_product_information_collection_info"
    },
    {
      "type": "header",
      "content": "Intro card"
    },
    {
      "type": "checkbox",
      "id": "show_intro_card",
      "label": "Show intro card",
      "info": "Adds an editable card to the grid (page 1 only). Content can be overridden per-collection via the collection's metafields; the fields below act as defaults. Leave all blank to hide it.",
      "default": false
    },
    {
      "type": "select",
      "id": "intro_card_position",
      "label": "Card position",
      "options": [
        { "value": "first", "label": "First slot" },
        { "value": "third", "label": "Third slot (right)" }
      ],
      "default": "third",
      "info": "Where the card sits in the grid. Can be overridden per-collection with the custom.intro_card_position metafield."
    },
    {
      "type": "checkbox",
      "id": "intro_card_white_bg",
      "label": "White background",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "intro_card_image",
      "label": "Placeholder image",
      "info": "When set, the card shows this image filling the slot instead of the text content below."
    },
    {
      "type": "image_picker",
      "id": "intro_card_logo",
      "label": "Logo / image"
    },
    {
      "type": "inline_richtext",
      "id": "intro_card_heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "intro_card_text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "intro_card_button_label",
      "label": "Button label",
      "info": "Optional — leave blank for no button."
    },
    {
      "type": "url",
      "id": "intro_card_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "t:global.product_list.product_list_category"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:global.faceting.products_per_page",
      "min": 8,
      "max": 50,
      "step": 1,
      "default": 48
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "t:global.product_list.products_per_row_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "products_size_desktop",
      "label": "t:global.product_list.products_size_desktop",
      "info": "t:global.product_list.products_size_desktop_info",
      "options": [
        {
          "value": "compact",
          "label": "t:global.product_list.products_size_desktop_options.compact"
        },
        {
          "value": "medium",
          "label": "t:global.product_list.products_size_desktop_options.medium"
        },
        {
          "value": "large",
          "label": "t:global.product_list.products_size_desktop_options.large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "t:global.product_list.spacing_category",
      "info": "t:global.product_list.spacing_category_info"
    },
    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "horizontal_spacing_factor",
      "label": "t:global.product_list.horizontal_spacing_factor",
      "default": 1
    },
    {
      "type": "range",
      "min": 0.2,
      "max": 2,
      "step": 0.1,
      "id": "vertical_spacing_factor",
      "label": "t:global.product_list.vertical_spacing_factor",
      "default": 1
    },
    {
      "type": "header",
      "content": "t:global.faceting.filters_and_sorting_category"
    },
    {
      "type": "select",
      "id": "filter_layout",
      "label": "t:global.faceting.desktop_layout",
      "options": [
        {
          "value": "sidebar",
          "label": "t:global.faceting.desktop_layout_options.sidebar"
        },
        {
          "value": "drawer",
          "label": "t:global.faceting.desktop_layout_options.drawer"
        }
      ],
      "default": "sidebar"
    },
    {
      "type": "link_list",
      "id": "quick_links_menu",
      "label": "t:sections.main_collection.quick_links_menu",
      "info": "t:sections.main_collection.quick_links_menu_info"
    },
    {
      "type": "checkbox",
      "id": "show_sort_by",
      "label": "t:global.faceting.show_sort_by",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "t:global.faceting.show_filters",
      "info": "t:global.faceting.show_filters_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_results_count",
      "label": "t:global.faceting.show_results_count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_filter_group_name",
      "label": "t:global.faceting.show_group_name",
      "info": "t:global.faceting.show_group_name_info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_filter_values_count",
      "label": "t:global.faceting.show_filter_values_count",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "open_filters_by_default",
      "label": "t:global.faceting.open_filters_by_default",
      "default": false
    }
  ]
}
{% endschema %}
{% stylesheet %}
.collection-intro-card {
  display: flex;
}

.collection-intro-card--image {
  display: block;
  width: 100%;
  aspect-ratio: 4 / 5;
  overflow: hidden;
}

.collection-intro-card__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.collection-intro-card__inner {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 1rem;
  width: 100%;
  height: 100%;
  padding: 2rem;
  background: #f2eee7;
  border-radius: 1rem;
}

.collection-intro-card--white .collection-intro-card__inner {
  background: #ffffff;
}

.collection-intro-card__logo {
  max-width: 160px;
  height: auto;
}

.collection-intro-card__heading {
  margin: 0;
  font-family: var(--heading-font-family, serif);
  font-weight: 400;
  font-size: 1.5rem;
  line-height: 1.2;
}

.collection-intro-card__text {
  font-size: 0.95rem;
  line-height: 1.5;
}
{% endstylesheet %}
