<div class="section-spacing color-scheme color-scheme--scheme-1">
  <div class="container container--sm">
    <div class="ring-size-guide">
      <div class="ring-size-guide__icon">
        <img src="{{ 'promise-ring.png' | asset_url }}" alt="Promise Ring" width="120">
      </div>

      {%- if section.settings.heading != blank -%}
        <h1 class="ring-size-guide__title ogg-font">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <div class="ring-size-guide__intro prose">{{ section.settings.intro }}</div>
      {%- endif -%}

      {%- render 'size-guide-table',
        table_class: 'ring-size-guide__table table--lg',
        wrapper_class: 'ring-size-guide__table-wrapper'
      -%}

      {%- assign pdf_url = settings.size_guide_pdf_url | default: section.settings.pdf_link -%}
      {%- if pdf_url == blank -%}
        {%- assign pdf_url = 'size-guide-promise-co-130126.pdf' | file_url -%}
      {%- endif -%}

      <div class="ring-size-guide__cta">
        <h2 class="ring-size-guide__title ogg-font">{{ section.settings.cta_heading | default: 'Still Not Sure?' }}</h2>
        <p class="ring-size-guide__text">Use our <a href="{{ pdf_url }}" target="_blank" style="text-decoration: underline;" download>handy printable PDF</a> to help you find your ring size</p>
      </div>

      {% if section.settings.preview_image != blank %}
        <div class="ring-size-guide__preview" style="margin: 2rem auto; max-width: 400px;">
          <a href="{{ pdf_url }}" target="_blank" download>
            <img
              src="{{ section.settings.preview_image | image_url: width: 600 }}"
              alt="Ring Size Guide Preview"
              width="600"
              loading="lazy"
              class="ring-size-guide__preview-image"
              style="width: 100%; height: auto; display: block; border: 1px solid #e5e5e5;"
            >
          </a>
        </div>
      {% endif %}

      <div class="ring-size-guide__actions">
        <a href="{{ pdf_url }}" class="button ring-size-guide__btn" target="_blank" download>DOWNLOAD OUR RING SIZER</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Ring Size Guide Content",
  "tag": "section",
  "class": "shopify-section--ring-size-guide-content",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Size Guide"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro text",
      "default": "<p>We now offer US sizes 4-10 across all women's rings, and 8-13 in our men's collection. All our rings follow standard US sizing.</p><p>At the moment, we don't offer half sizes – but we've included a sizing guide below to help you find your best fit.</p><p>If your size isn't available, we'd love to hear from you. Please get in touch via our contact page – we're always open to expanding our range based on customer feedback.</p>"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA heading",
      "default": "Still Not Sure?"
    },
    {
      "type": "paragraph",
      "content": "The size table is managed centrally via the 'Ring size' metaobject (Settings → Custom data) and is shared with the product Size Guide popup."
    },
    {
      "type": "image_picker",
      "id": "preview_image",
      "label": "PDF Preview Image"
    },
    {
      "type": "url",
      "id": "pdf_link",
      "label": "PDF Download Link (Override)",
      "info": "Leave blank to use the global Size Guide PDF from Theme Settings"
    }
  ]
}
{% endschema %}
